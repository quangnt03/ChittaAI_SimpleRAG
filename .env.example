# Copy this file to .env.local and replace the placeholder value.
OPENAI_API_KEY=your-openai-api-key

# Optional overrides
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Milvus connection
MILVUS_URL=http://localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=rag_documents

CHUNK_SIZE=1000
CHUNK_OVERLAP=200
