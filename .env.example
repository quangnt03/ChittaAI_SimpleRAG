# Copy this file to .env.local and replace the placeholder value.
OPENAI_API_KEY=your-openai-api-key

# Optional overrides
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Milvus connection
MILVUS_URL=http://localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=rag_documents

# Milvus hybrid index and search tuning
MILVUS_HNSW_M=16
MILVUS_HNSW_EF_CONSTRUCTION=200
MILVUS_HNSW_EF=64
MILVUS_BM25_K1=1.2
MILVUS_BM25_B=0.75
MILVUS_SPARSE_DROP_RATIO=0.0
MILVUS_CANDIDATE_MULTIPLIER=4
MILVUS_RRF_K=60
MILVUS_CONSISTENCY_LEVEL=Session

CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Optional DeepEval controls. Set RUN_RAG_EVALS=1 only for live evaluation.
# RUN_RAG_EVALS=1
RAG_EVAL_MODEL=gpt-4.1
RAG_EVAL_THRESHOLD=0.7
RAG_EVAL_TOP_K=4
DEEPEVAL_RESULTS_FOLDER=./evaluation/results
MILVUS_COLLECTION=rag_documents_hybrid